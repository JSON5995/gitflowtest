{
  "version": 1,
  "install": ["npm", "ci"],
  "checks": [
    ["npm", "run", "lint"],
    ["npm", "run", "typecheck"],
    ["npm", "test"],
    ["npm", "run", "build"]
  ],
  "qa": [
    ["npm", "test"],
    ["npm", "run", "build"]
  ],
  "start": ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"],
  "healthUrl": "http://127.0.0.1:3000/",
  "protectedPaths": [
    ".github/workflows/",
    ".github/CODEOWNERS",
    ".cursor/rules/flow.mdc",
    "migrations/",
    ".flow/",
    "AGENTS.md",
    "CLAUDE.md",
    "scripts/run-contract.mjs",
    "scripts/check-review.mjs",
    "scripts/parse-cursor-result.mjs",
    "scripts/clarification.mjs",
    "scripts/resolve-preview.mjs",
    "scripts/run-real-qa.mjs"
  ]
}
