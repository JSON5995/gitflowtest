{
  "version": 1,
  "install": [
    "npm",
    "ci"
  ],
  "checks": [
    [
      "npm",
      "run",
      "lint"
    ],
    [
      "npm",
      "run",
      "typecheck"
    ],
    [
      "npm",
      "run",
      "test"
    ],
    [
      "npm",
      "run",
      "build"
    ],
    [
      "docker",
      "build",
      "--tag",
      "flow-candidate",
      "."
    ]
  ],
  "start": [
    "npm",
    "run",
    "start"
  ],
  "protectedPaths": [
    ".cursor/rules/flow.mdc",
    ".flow/",
    ".github/CODEOWNERS",
    ".github/workflows/",
    "AGENTS.md",
    "CLAUDE.md",
    "Dockerfile",
    "Dockerfile.*",
    "compose.yml",
    "docker-compose.yml",
    "migrations/",
    "scripts/check-review.mjs",
    "scripts/clarification.mjs",
    "scripts/parse-cursor-result.mjs",
    "scripts/resolve-preview.mjs",
    "scripts/run-contract.mjs",
    "scripts/run-real-qa.mjs"
  ]
}
