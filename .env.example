NODE_ENV=production
PUBLIC_URL=https://flow.example.com
PORT=3000
DATABASE_PATH=./data/flow.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=

# Set this single value to use one vendor for build, review, and visual QA.
# Leave it blank to choose separate builders and reviewers below.
FLOW_AGENT=
FLOW_BUILDER=codex
FLOW_REVIEWER=claude
# Human GitHub users or teams that must approve every generated PR.
# Examples: @octocat or @your-org/platform-team (separate several with commas).
FLOW_CODEOWNERS=
FLOW_MAX_FIX_ROUNDS=2
